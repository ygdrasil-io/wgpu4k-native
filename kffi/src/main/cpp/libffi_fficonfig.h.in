#ifndef KFFI_FFICONFIG_H
#define KFFI_FFICONFIG_H

#define HAVE_ALLOCA_H 1
#define HAVE_MEMCPY 1
#define HAVE_MEMORY_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRING_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_UNISTD_H 1
#define HAVE_DLFCN_H 1
#define STDC_HEADERS 1
#define HAVE_HIDDEN_VISIBILITY_ATTRIBUTE 1

#define SIZEOF_DOUBLE 8
#define SIZEOF_LONG_DOUBLE 16

#if @HAVE_AS_X86_PCREL@
#define HAVE_AS_X86_PCREL 1
#endif

@EH_FRAME_FLAGS_DEFINE@

/*
 * Closures on Android. FFI_EXEC_TRAMPOLINE_TABLE must stay undefined (it is
 * Mach-only; ffitarget.h errors if it is set on a non-Mach target). Instead,
 * mirror what libffi's autotools configure produces for *-linux-android*
 * targets:
 *   - FFI_MMAP_EXEC_WRIT  routes ffi_closure_alloc through dlmalloc-backed
 *     executable segments instead of the plain-malloc path (the Android heap
 *     is not executable, so plain-malloc closures would crash).
 *   - FFI_EXEC_STATIC_TRAMP allocates closure trampolines from a static
 *     trampoline table mapped RX from the libffi text segment (via /proc
 *     self-maps), never executing heap memory.
 *
 * HAVE_MEMFD_CREATE is intentionally NOT defined: the NDK only declares
 * memfd_create for _GNU_SOURCE builds at API >= 30, and kffi's minSdk is 28.
 * The static-trampoline path never needs the memfd fallback on a file-backed
 * libkffi.so.
 */
#define FFI_MMAP_EXEC_WRIT 1
#define FFI_EXEC_STATIC_TRAMP 1

#ifdef HAVE_HIDDEN_VISIBILITY_ATTRIBUTE
#ifdef LIBFFI_ASM
#ifdef __APPLE__
#define FFI_HIDDEN(name) .private_extern name
#else
#define FFI_HIDDEN(name) .hidden name
#endif
#else
#define FFI_HIDDEN __attribute__ ((visibility ("hidden")))
#endif
#else
#ifdef LIBFFI_ASM
#define FFI_HIDDEN(name)
#else
#define FFI_HIDDEN
#endif
#endif

#endif /* KFFI_FFICONFIG_H */
